# Server-only Supabase credentials. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
DEFAULT_TEMPLE_SLUG=wat-banlao
NEXT_PUBLIC_TEMPLE_SLUG=wat-banlao
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required only when content helpers execute during SSR/local server rendering.
SITE_URL=http://localhost:3300
# Must match Supabase Auth > Email OTP expiration. Supabase defaults to 1 hour.
TEMPLE_INVITE_EXPIRY_HOURS=3
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=''
